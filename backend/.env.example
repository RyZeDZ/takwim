# First admin account, created automatically on first start (password: 8+ characters)
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Name shown at the top of the API docs
APP_NAME=Timetable API

# Database file (SQLite). The file and its tables are created automatically.
DATABASE_URL=sqlite:///./timetable.db

# How long someone stays logged in before having to log in again (hours)
LOGIN_EXPIRES_HOURS=72

# Address of the frontend allowed to call the API, comma-separated. * = any (fine for the demo)
CORS_ORIGINS=*

# 1 = the admin may load the synthetic demo department (only into an empty database)
DEMO_MODE=0

# AI plug-ins (modules in the repository's ai/ folder). Empty = the built-in greedy solver.
SOLVER_MODULE=ai.solver
COLUMN_MAPPER_MODULE=
# CP-SAT solver: seconds of search per generation, and CPU threads used
SOLVER_TIME_LIMIT=10
SOLVER_WORKERS=4
